{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@/*": ["./*"],
      "@playgrowth/config": ["../../packages/config/src/index.ts"],
      "@playgrowth/contracts": ["../../packages/contracts/src/index.ts"],
      "@playgrowth/domain": ["../../packages/domain/src/index.ts"],
      "@playgrowth/ui": ["../../packages/ui/src/index.ts"]
    },
    "plugins": [{ "name": "next" }],
    "types": ["@cloudflare/workers-types", "node"],
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".next", "dist"]
}
