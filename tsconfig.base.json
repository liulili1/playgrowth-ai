{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "@playgrowth/config": ["./packages/config/src/index.ts"],
      "@playgrowth/contracts": ["./packages/contracts/src/index.ts"],
      "@playgrowth/domain": ["./packages/domain/src/index.ts"],
      "@playgrowth/ui": ["./packages/ui/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
